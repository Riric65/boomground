<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : pas d'icône système au lancement, juste le fond du
         jeu ; l'écran de chargement du jeu prend le relais. -->
    <style name="BoomGroundTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/boot_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowSplashScreenBackground">@color/boot_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
