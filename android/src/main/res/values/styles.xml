<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fenêtre sans barre de titre : le jeu dessine lui-même son interface
         sur toute la surface, et Vulkan se charge du reste. -->
    <style name="BoomGroundTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/boot_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
